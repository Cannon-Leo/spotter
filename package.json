{
  "name": "spotter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:next": "node -e \"const fs=require('fs'),p='.next';const scan=d=>fs.readdirSync(d,{withFileTypes:true}).some(e=>e.isSymbolicLink()||(e.isDirectory()&&scan(d+'/'+e.name)));if(fs.existsSync(p)&&scan(p)){fs.rmSync(p,{recursive:true,force:true});console.log('Cleared .next: OneDrive cloud placeholders found')}\"",
    "predev": "npm run clean:next",
    "dev": "next dev --webpack",
    "prebuild": "npm run clean:next",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "test": "node --experimental-strip-types --test tests/profile-rules.test.mjs tests/zod-schemas.test.mjs",
    "type-check": "tsc --noEmit",
    "build-tokens": "node scripts/build-tokens.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:issue-code": "node scripts/issue-activation-code.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "next": "^16.4.6",
    "nodemailer": "^10.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "prisma": "6.19.3",
    "typescript": "^5.6.2"
  }
}
