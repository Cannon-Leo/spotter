# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL with pgvector (PRD 8.1).
# DATABASE_URL is the pooled/application connection.
# DIRECT_URL is unpooled and used only by Prisma Migrate.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/spotter?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/spotter?sslmode=require"

# HMAC-SHA256 signing key for member session cookies. Rotating it signs every member out.
# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# AI / Gemini (PRD 7.1). Verify the free tier before building.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_LANGUAGE_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# ---------------------------------------------------------------------------
# Payments. PROVISIONAL NAMES - gateway not finalised in writing.
# PRD 8.1 names Paystack; the project brief says Flutterwave. These are
# placeholders for Flutterwave and are not read by any code yet. Rename or
# replace them once the gateway decision is confirmed in writing.
# ---------------------------------------------------------------------------
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""
# Secret hash sent by Flutterwave in the verif-hash header; checked before any
# database write (PRD 8.3 webhook authenticity).
FLUTTERWAVE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Scheduled jobs (PRD 8.1). Vercel Cron calls the two routes daily; this secret
# authenticates those calls. There is no check-in secret: the four digit daily
# code is generated and stored in the database by the 04:00 job.
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
